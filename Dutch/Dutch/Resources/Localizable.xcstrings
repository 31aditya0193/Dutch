    "qrInvitationInstructions" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only people you invite can join, so scanning this code won't work on its own. Use Invite People, and allow anyone with the link from there."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko ludzie których zaprosisz mogą dołączyć, więc skanowanie tego kodu nie zadziała samo z siebie. Użyj Zaproś Użytkowników i zezwól każdemu na dołączenie przez link z tego miejsca."
          }
        }
      }
    },
