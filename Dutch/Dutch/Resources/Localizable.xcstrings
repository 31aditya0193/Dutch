    "dutchPrivacyDisclosure" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dutch keeps your groups in your own iCloud account. Nothing is stored on any server of ours, because there isn't one."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dutch przechowuje twoje grupy na twoim koncie iCloud. Nic nie jest przechowywane na żadnym serwerze, bo taki nawet nie istnieje."
          }
        }
      }
    },
