    "partialPercentageExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percent of a full share, 1 to 200. A fare with 51% off is 49."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procent całości kosztów, od 1 do 200. Przejazd z ulgą 51% to 49%."
          }
        }
      }
    },
    "percentageSplitExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100% is a full share — a 51% off fare is 49%, and two people sharing one hotel room are 50% each. The amounts beside each name always add up to the total."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100% to całość kosztów - 51% ulgi to 49%, a dwie osoby dzielące jeden pokój hotelowy to 50% dla każdej. Kwoty przy każdym imieniu zawsze sumują się do kwoty całkowitej."
          }
        }
      }
    },
    "personalizationFooterInfo" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The name and colour are how everyone in the group sees this person, on their phone as well as yours."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazwa i kolor są widoczne dla każdego w grupie, na ich urządzeniach tak jak na twoim."
          }
        }
      }
    },
    "pricingDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One group is free. Unlock unlimited groups with a one-time purchase — joining other people's groups is always free."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedna grupa jest darmowa. Odblokuj nieskończoną ilość group jednorazową płatnością - dołączanie do grup utworzonych przez innych użytkowników jest zawsze darmowe."
          }
        }
      }
    },
