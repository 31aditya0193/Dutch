<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- No UIApplicationShortcutItems here, deliberately. The quick action is
	     registered at runtime by DutchApp.refreshQuickActions() so it can name
	     the group it will open.

	     A static twin is not a fallback for that, it is a duplicate: the system
	     shows the static list *and* the dynamic one, and setting
	     UIApplication.shortcutItems never replaces the plist entry. With both
	     defined the menu carried two "New Expense" rows doing the same thing. -->
</dict>
</plist>
