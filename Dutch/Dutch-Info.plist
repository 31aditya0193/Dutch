<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- The static quick action, so a fresh install has one before any group
	     has been opened. Replaced at runtime by a copy subtitled with the group
	     you were last in — see DutchApp.refreshQuickActions().

	     Here rather than in an INFOPLIST_KEY_ build setting because the value
	     is an array, and that mechanism silently drops array values. That is
	     how this app once went months without its background modes. -->
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>net.smigi.Dutch.newExpense</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>New Expense</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>plus.circle</string>
		</dict>
	</array>
</dict>
</plist>
